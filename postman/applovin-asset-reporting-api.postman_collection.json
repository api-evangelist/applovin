            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/assetReport?api_key=<string>&range=last_7d&columns=<string>&format=json&limit=<integer>&offset=<integer>&not_zero=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "assetReport"
              ],
              "query": [
                {
                  "description": "(Required) Report Key from the Axon dashboard.",
                  "key": "api_key",
                  "value": "<string>"
                },
                {
                  "description": "(Required) Symbolic time range.",
                  "key": "range",
                  "value": "last_7d"
                },
                {
                  "description": "(Required) Comma-separated list of asset report columns.",
                  "key": "columns",
                  "value": "<string>"
                },
