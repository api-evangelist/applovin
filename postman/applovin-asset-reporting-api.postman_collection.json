                  "value": "json"
                },
                {
                  "key": "limit",
                  "value": "<integer>"
                },
                {
                  "key": "offset",
                  "value": "<integer>"
                },
                {
                  "description": "Set to 1 to exclude all-zero rows.",
                  "key": "not_zero",
                  "value": "0"
