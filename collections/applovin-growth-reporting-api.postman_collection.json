  "item": [
    {
      "id": "b5a7e808-280e-4c80-aa67-1476dd76d8ea",
      "name": "Growth Reporting",
      "description": {
        "content": "Campaign performance reporting for advertisers and publishers",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "fa4aca47-a575-411d-9141-1df11a38efcb",
          "name": "Get Growth Report",
          "request": {
            "name": "Get Growth Report",
            "description": {
              "content": "Retrieve aggregated AppDiscovery / Axon campaign metrics for either\nthe publisher or advertiser perspective. Date ranges are limited to a\n45-day rolling window. The response payload shape varies with the\nselected `columns` and `report_type`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "report"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Report Key, found under Account > Keys in the Axon dashboard."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<string>",
                  "description": "(Required) Inclusive start date in YYYY-MM-DD or Unix epoch seconds. Must be within a 45-day window with end."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<string>",
                  "description": "(Required) Inclusive end date in YYYY-MM-DD, Unix epoch seconds, or the literal string `now`."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "(Required) Response format."
                },
                {
                  "disabled": false,
                  "key": "columns",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of columns to include. Available columns differ between publisher and advertiser report types."
                },
                {
                  "disabled": false,
                  "key": "report_type",
                  "value": "publisher",
                  "description": "Choose between publisher or advertiser report dimensions."
                },
                {
                  "disabled": false,
                  "key": "day_column",
                  "value": "<string>",
                  "description": "Set to `day` to compute cohort metrics. Defaults to realtime when absent."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum rows to return."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Pagination row offset."
                },
                {
                  "disabled": false,
                  "key": "having",
                  "value": "<string>",
                  "description": "URL-encoded numeric filtering (e.g. `impressions > 0`)."
                },
                {
                  "disabled": false,
                  "key": "not_zero",
                  "value": "<integer>",
                  "description": "Set to 1 to exclude rows where all metrics are zero."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
