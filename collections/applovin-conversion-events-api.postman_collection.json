          "name": "Post Conversion Events",
          "request": {
            "name": "Post Conversion Events",
            "description": {
              "content": "Submit a batch of up to 100 server-side conversion events\n(`page_view`, `generate_lead`) for ingestion against your Axon Pixel.\nAt least one user identifier is required per event in `user_data`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "event"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pixel_id",
                  "value": "<string>",
                  "description": "(Required) Axon Event Key for the destination pixel."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"name\": \"<string>\",\n      \"event_time\": \"<long>\",\n      \"event_source_url\": \"<uri>\",\n      \"data\": {\n        \"currency\": \"<string>\",\n        \"value\": \"<number>\"\n      },\n      \"user_data\": {\n        \"client_ip_address\": \"<string>\",\n        \"client_user_agent\": \"<string>\",\n        \"esi\": \"<string>\",\n        \"aleid\": \"<string>\",\n        \"axwrt\": \"<string>\",\n        \"alart\": \"<string>\",\n        \"client_id\": \"<string>\",\n        \"user_id\": \"<string>\",\n        \"email\": \"<string>\",\n        \"phone\": \"<string>\",\n        \"country_code\": \"<string>\",\n        \"zip\": \"<string>\",\n        \"os\": \"<string>\",\n        \"sid\": \"<string>\",\n        \"ifa\": \"<string>\",\n        \"idfv\": \"<string>\"\n      },\n      \"dedupe_id\": \"<string>\"\n    },\n    {\n      \"name\": \"<string>\",\n      \"event_time\": \"<long>\",\n      \"event_source_url\": \"<uri>\",\n      \"data\": {\n        \"currency\": \"<string>\",\n        \"value\": \"<number>\"\n      },\n      \"user_data\": {\n        \"client_ip_address\": \"<string>\",\n        \"client_user_agent\": \"<string>\",\n        \"esi\": \"<string>\",\n        \"aleid\": \"<string>\",\n        \"axwrt\": \"<string>\",\n        \"alart\": \"<string>\",\n        \"client_id\": \"<string>\",\n        \"user_id\": \"<string>\",\n        \"email\": \"<string>\",\n        \"phone\": \"<string>\",\n        \"country_code\": \"<string>\",\n        \"zip\": \"<string>\",\n        \"os\": \"<string>\",\n        \"sid\": \"<string>\",\n        \"ifa\": \"<string>\",\n        \"idfv\": \"<string>\"\n      },\n      \"dedupe_id\": \"<string>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "9ad1dca3-2b20-4012-b4c5-e4f1be52a52c",
              "name": "All events processed successfully.",
