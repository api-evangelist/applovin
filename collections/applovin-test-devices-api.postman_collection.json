    "_postman_id": "7e8fd5d3-ff08-4557-bab9-8bc1f19d7fcd",
    "name": "AppLovin Axon Campaign Management Ad Units Test Devices API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST endpoints used to programmatically manage AppLovin AppDiscovery\n(Axon) campaigns, creative sets, and creative assets. All endpoints\nrequire an `Authorization` header with the Campaign Management API key\nand an `account_id` query parameter. Rate limit: 1,000 requests per 60\nseconds (HTTP 429 on overflow).\n\n\nContact Support:\n Name: AppLovin Support",
      "type": "text/plain"
    }
  }
