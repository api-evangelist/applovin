                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Report Key from the Axon dashboard."
                },
                {
                  "disabled": false,
                  "key": "range",
                  "value": "<string>",
                  "description": "(Required) Symbolic time range."
                },
                {
                  "disabled": false,
                  "key": "columns",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of asset report columns."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format. Defaults to JSON."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>"
                },
                {
                  "disabled": false,
                  "key": "not_zero",
                  "value": "<integer>",
