          "name": "Get Asset Report by Range",
          "request": {
            "name": "Get Asset Report by Range",
            "description": {
              "content": "Returns asset-level metrics (impressions, clicks, CTR, cost) for a\nsymbolic time range such as `yesterday`, `last_7d`, or `last_month`.\n",
              "type": "text/plain"
            },
