      "name": "Revenue Reporting",
      "description": {
        "content": "Mediation revenue and user-level reporting",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ee3f9042-5ab6-4200-af3d-42afa88e2b62",
          "name": "Get MAX Revenue Report",
          "request": {
            "name": "Get MAX Revenue Report",
            "description": {
              "content": "Retrieve aggregated MAX revenue and user-level metrics for a publisher\naccount. Specify the columns you want returned plus a date range\n(start, end) within a rolling 45-day window. Optional filters, sort,\nlimit, and offset support customised reporting and pagination.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "maxReport"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Report Key (issued under Account > Keys in the Axon dashboard)."
                },
                {
                  "disabled": false,
                  "key": "columns",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of report columns to return."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<date>",
                  "description": "(Required) Inclusive start date in YYYY-MM-DD. Must fall within a 45-day request window with end."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<date>",
                  "description": "(Required) Inclusive end date in YYYY-MM-DD. Must fall within a 45-day request window with start."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format. Defaults to JSON."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum rows to return."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Number of rows to skip for pagination."
                },
                {
                  "disabled": false,
                  "key": "not_zero",
                  "value": "<integer>",
                  "description": "Set to 1 to exclude rows where all metrics are zero."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
